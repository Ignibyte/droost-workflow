# TICKET-136: analyse modules/droost_workflow_mcp from INSIDE the site container,
# where droost, mcp_server and mcp/sdk all exist. Not part of the package's
# portable gate (see phpstan.neon for why none can be) — run at validate.
parameters:
  level: max
  paths:
    - modules
  treatPhpDocTypesAsCertain: false
  scanDirectories:
    - /var/www/html/web/modules/contrib/droost/src
    - /var/www/html/web/modules/contrib/droost/modules
    - /var/www/html/web/modules/contrib/mcp_server/src
    - /var/www/html/vendor/mcp/sdk/src
