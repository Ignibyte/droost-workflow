#!/usr/bin/env node
/**
 * @file
 * The parity gate's runner: does each page of the site look like its
 * reference?
 *
 * A reference is a page of the source (a design, or the site being rebuilt)
 * read once and kept in the project: every visible element that carries
 * text, with its box and the computed style that decides how it looks
 * (typeface, size, weight, case, colour, the colour it sits on), and the
 * header, footer and header links. The gate reads the same page on the site
 * and judges each element of the reference against it, matched by text in
 * document order:
 *
 *   D1  the page answers 200 and does not scroll sideways
 *   D2  every reference text is on the site, in order
 *   D3  each pair: the same typeface, size within 2px, weight within 100, the
 *       same case as rendered
 *   D4  each pair: text colour and the colour it sits on within 12 (CIE76)
 *   D5  each pair: x within 16px, width within 15% (or 24px), and y within
 *       24px of where it sits below its section's heading
 *   D6  the header's links: the same labels and targets, in order
 *   D7  the header's height and stickiness, the footer's colour and border
 *
 * D2 and D6 pass at 100%, D3 to D5 at 95% of pairs. The site may carry more
 * than the reference; what the reference has, the site must have, looking the
 * same. A page this cannot read, or a colour it cannot parse, is INVALID,
 * never a pass.
 *
 *   droost-parity capture --source <url> --routes /,/camps [--out droost/parity] [--width 1280]
 *   droost-parity judge [--reference droost/parity] [--routes …] [--scope page|frame|header|footer]
 *                       [--base <url>] [--json]
 *
 * The site's base URL: --base, else DROOST_PARITY_BASE_URL, PLAYWRIGHT_BASE_URL
 * or DDEV_PRIMARY_URL (the address the site's own browser suite uses).
 * Playwright is the project's own (node_modules/playwright).
 *
 * Exit: 0 every route as the reference; 1 a route differs; 2 a route could
 * not be read (INVALID); 3 no reference to compare with; 127 no Playwright.
 * The last line of stdout is always one JSON object, {"parity": {...}}.
 */
'use strict';

const fs = require('fs');
const path = require('path');

const EXIT = { pass: 0, fail: 1, invalid: 2, nothing: 3, noBrowser: 127 };

function args(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const key = a.slice(2);
      const next = argv[i + 1];
      if (next === undefined || next.startsWith('--')) out[key] = true;
      else { out[key] = next; i++; }
    } else out._.push(a);
  }
  return out;
}

function finish(summary, code) {
  process.stdout.write(JSON.stringify({ parity: summary }) + '\n');
  process.exit(code);
}

function playwright() {
  const where = path.join(process.cwd(), 'node_modules', 'playwright');
  try {
    return require(where);
  } catch (e) {
    finish({ status: 'no-browser', summary: `no Playwright at ${where}: install it (npm i -D playwright @playwright/test) and its Chromium` }, EXIT.noBrowser);
  }
  return null;
}

// A route's file name in the reference directory.
const slug = (route) => (route === '/' ? 'home' : route.replace(/^\/+|\/+$/g, '').replace(/[^A-Za-z0-9_-]+/g, '_')) + '.json';

// ---------------------------------------------------------------------------
// Reading a page.
// ---------------------------------------------------------------------------

async function read(browser, url, width) {
  // A fresh context per page (no cache to serve from) and no extra request
  // header: on a cross-origin font request one forces a CORS preflight a font
  // host may fail, and the page falls back to another typeface.
  const ctx = await browser.newContext({ viewport: { width, height: 900 }, ignoreHTTPSErrors: true });
  const page = await ctx.newPage();
  let status = 'ERR';
  try {
    const res = await page.goto(url, { waitUntil: 'load', timeout: 60000 });
    status = res ? res.status() : 'ERR';
  } catch (e) {
    status = 'ERR ' + String(e.message || e).slice(0, 160);
  }
  // Network idle when it comes within 8 s: a page with a widget that polls is
  // never idle.
  await page.waitForLoadState('networkidle', { timeout: 8000 }).catch(() => {});
  await page.evaluate(async () => {
    await document.fonts.ready;
    // In-view animations run only once their section has been in the viewport.
    for (let y = 0; y < document.documentElement.scrollHeight; y += 300) { window.scrollTo(0, y); await new Promise((r) => setTimeout(r, 100)); }
    window.scrollTo(0, 0);
  }).catch(() => {});
  await page.waitForTimeout(1200);
  const data = await page.evaluate(() => {
    const px = (v) => Math.round(parseFloat(v) || 0);
    const ground = (el) => {
      for (let n = el; n && n.nodeType === 1; n = n.parentElement) {
        const c = getComputedStyle(n).backgroundColor;
        const m = c.match(/rgba?\(([^)]+)\)/);
        if (m) { const p = m[1].split(',').map(Number); if (p.length < 4 || p[3] > 0.5) return c; }
        if (getComputedStyle(n).backgroundImage !== 'none') return 'image';
      }
      return 'rgb(255, 255, 255)';
    };
    const visible = (el) => {
      const s = getComputedStyle(el);
      if (s.visibility === 'hidden' || s.display === 'none' || parseFloat(s.opacity) === 0) return false;
      const r = el.getBoundingClientRect();
      return r.width > 0 && r.height > 0;
    };
    const texts = [];
    for (const el of document.body.querySelectorAll('*')) {
      if (['SCRIPT', 'STYLE', 'NOSCRIPT', 'SVG', 'PATH', 'TEMPLATE'].includes(el.tagName)) continue;
      const own = [...el.childNodes].filter((n) => n.nodeType === 3).map((n) => n.textContent).join(' ').replace(/\s+/g, ' ').trim();
      if (!own || !visible(el)) continue;
      const r = el.getBoundingClientRect(); const s = getComputedStyle(el);
      texts.push({
        tag: el.tagName.toLowerCase(), text: own,
        x: Math.round(r.left + scrollX), y: Math.round(r.top + scrollY), w: Math.round(r.width), h: Math.round(r.height),
        font: s.fontFamily.split(',')[0].replace(/["']/g, '').trim(), size: px(s.fontSize), weight: Number(s.fontWeight),
        transform: s.textTransform, color: s.color, ground: ground(el),
        link: el.closest('a') ? el.closest('a').getAttribute('href') : null,
        inHeader: !!el.closest('header, nav, [role=banner]'), inFooter: !!el.closest('footer, [role=contentinfo]'),
      });
    }
    const box = (el) => { if (!el) return null; const r = el.getBoundingClientRect(); const s = getComputedStyle(el);
      return { y: Math.round(r.top + scrollY), h: Math.round(r.height), bg: s.backgroundColor, bgImage: s.backgroundImage !== 'none', borderTop: s.borderTopWidth + ' ' + s.borderTopColor, position: s.position }; };
    const header = document.querySelector('body header, body nav');
    const footer = [...document.querySelectorAll('footer')].pop() || null;
    const navLinks = header ? [...header.querySelectorAll('a')].filter(visible).map((a) => ({ text: a.textContent.replace(/\s+/g, ' ').trim(), href: a.getAttribute('href') })) : [];
    return {
      height: document.documentElement.scrollHeight,
      hscroll: document.documentElement.scrollWidth > document.documentElement.clientWidth,
      header: box(header), footer: box(footer), navLinks, texts,
    };
  }).catch((e) => ({ error: String(e.message || e).slice(0, 200), texts: [] }));
  await ctx.close();
  return { url, status, viewport: width, ...data };
}

// ---------------------------------------------------------------------------
// Judging a pair of readings.
// ---------------------------------------------------------------------------

class Unreadable extends Error {}

function toRgb(c) {
  if (c === 'image') return null;
  if (!c) throw new Unreadable(JSON.stringify(c));
  if (c === 'transparent') return [255, 255, 255];
  const num = (x) => (x.endsWith('%') ? parseFloat(x) / 100 : parseFloat(x));
  let m = c.match(/^oklch\(([^)]+)\)/);
  if (m) {
    const p = m[1].trim().split(/[\s/]+/).filter(Boolean);
    const L = p[0].endsWith('%') ? parseFloat(p[0]) / 100 : parseFloat(p[0]);
    const C = p[1] !== 'none' ? parseFloat(p[1]) : 0;
    const H = p[2] !== 'none' ? parseFloat(p[2]) * Math.PI / 180 : 0;
    return toRgb(`oklab(${L} ${C * Math.cos(H)} ${C * Math.sin(H)} / ${p.length > 3 ? p[3] : '1'})`);
  }
  m = c.match(/^rgba?\(([^)]+)\)/);
  if (m) {
    const p = m[1].trim().split(/[,\s/]+/).filter(Boolean).map(num);
    const a = p.length > 3 ? p[3] : 1;
    return [0, 1, 2].map((i) => p[i] * a + 255 * (1 - a));
  }
  m = c.match(/^oklab\(([^)]+)\)/);
  if (m) {
    const p = m[1].trim().split(/[\s/]+/).filter(Boolean).map(num);
    const [L, A, B] = p; const a = p.length > 3 ? p[3] : 1;
    const l = (L + 0.3963377774 * A + 0.2158037573 * B) ** 3;
    const mm = (L - 0.1055613458 * A - 0.0638541728 * B) ** 3;
    const s = (L - 0.0894841775 * A - 1.2914855480 * B) ** 3;
    const lin = [4.0767416621 * l - 3.3077115913 * mm + 0.2309699292 * s, -1.2684380046 * l + 2.6097574011 * mm - 0.3413193965 * s, -0.0041960863 * l - 0.7034186147 * mm + 1.7076147010 * s];
    return lin.map((v) => 255 * (v <= 0.0031308 ? 12.92 * v : 1.055 * Math.max(v, 0) ** (1 / 2.4) - 0.055)).map((v) => Math.min(255, Math.max(0, v)) * a + 255 * (1 - a));
  }
  throw new Unreadable(c);
}

function lab(rgb) {
  const f = (v) => { v /= 255; return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; };
  const [r, g, b] = rgb.map(f);
  const x = (0.4124 * r + 0.3576 * g + 0.1805 * b) / 0.95047; const y = 0.2126 * r + 0.7152 * g + 0.0722 * b; const z = (0.0193 * r + 0.1192 * g + 0.9505 * b) / 1.08883;
  const g_ = (t) => (t > 0.008856 ? t ** (1 / 3) : 7.787 * t + 16 / 116);
  return [116 * g_(y) - 16, 500 * (g_(x) - g_(y)), 200 * (g_(y) - g_(z))];
}

function dist(c1, c2) {
  const a = toRgb(c1); const b = toRgb(c2);
  if (a === null || b === null) return (c1 === 'image') === (c2 === 'image') ? 0 : 99;
  const [p, q] = [lab(a), lab(b)];
  return Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]);
}

const norm = (t) => t.normalize('NFKC').replace(/–|—/g, '-').replace(/’/g, "'").replace(/\s+/g, ' ').trim().toLowerCase();
const caseOf = (e) => (e.transform === 'uppercase' || (e.text.toUpperCase() === e.text && e.text.toLowerCase() !== e.text) ? 'upper' : 'as-written');

// difflib.SequenceMatcher(None, a, b, autojunk=False).get_matching_blocks().
function matchingBlocks(a, b) {
  const b2j = new Map();
  b.forEach((x, j) => { if (!b2j.has(x)) b2j.set(x, []); b2j.get(x).push(j); });
  const longest = (alo, ahi, blo, bhi) => {
    let besti = alo; let bestj = blo; let bestsize = 0; let j2len = new Map();
    for (let i = alo; i < ahi; i++) {
      const next = new Map();
      for (const j of b2j.get(a[i]) || []) {
        if (j < blo) continue;
        if (j >= bhi) break;
        const k = (j2len.get(j - 1) || 0) + 1;
        next.set(j, k);
        if (k > bestsize) { besti = i - k + 1; bestj = j - k + 1; bestsize = k; }
      }
      j2len = next;
    }
    return [besti, bestj, bestsize];
  };
  const queue = [[0, a.length, 0, b.length]]; const blocks = [];
  while (queue.length) {
    const [alo, ahi, blo, bhi] = queue.pop();
    const [i, j, k] = longest(alo, ahi, blo, bhi);
    if (k) {
      blocks.push([i, j, k]);
      if (alo < i && blo < j) queue.push([alo, i, blo, j]);
      if (i + k < ahi && j + k < bhi) queue.push([i + k, ahi, j + k, bhi]);
    }
  }
  return blocks.sort((x, y) => x[0] - y[0] || x[1] - y[1]);
}

function judge(reference, site, scope) {
  let D = reference.texts || []; let S = site.texts || [];
  if (['frame', 'header', 'footer'].includes(scope)) {
    const keep = { frame: (e) => e.inHeader || e.inFooter, header: (e) => e.inHeader, footer: (e) => e.inFooter }[scope];
    D = D.filter(keep); S = S.filter(keep);
  }
  const rows = [];
  if (!Number.isInteger(site.status) || !(site.texts || []).length) {
    rows.push({ id: 'D1', verdict: 'INVALID', said: `the page was not read (status ${String(site.status).slice(0, 120)}, ${(site.texts || []).length} texts)` });
    return rows;
  }
  const pairs = [];
  for (const [i, j, n] of matchingBlocks(D.map((e) => norm(e.text)), S.map((e) => norm(e.text)))) for (let k = 0; k < n; k++) pairs.push([D[i + k], S[j + k]]);
  const matched = new Set(pairs.map(([d]) => d));
  const missing = D.filter((d) => !matched.has(d));
  const row = (id, ok, said, extra = {}) => rows.push({ id, verdict: ok ? 'PASS' : 'FAIL', said, ...extra });
  const share = (bad, n, need) => { const got = n ? 1 - bad.length / n : 0; return [got >= need, `${n - bad.length}/${n} pairs (${Math.round(got * 100)}%, needs ${Math.round(need * 100)}%)`]; };
  const show = (e) => `${e.tag} "${e.text.slice(0, 40)}"`;

  row('D1', site.status === 200 && !site.hscroll, `HTTP ${site.status}, scrolls sideways: ${site.hscroll ? 'yes' : 'no'}`);
  row('D2', !missing.length && D.length > 0, `${pairs.length}/${D.length} reference texts found in order` + (missing.length ? '; missing: ' + missing.slice(0, 12).map(show).join('; ') : ''), { missing: missing.map((d) => d.text) });
  const bad3 = [];
  for (const [d, s] of pairs) {
    const why = [];
    if (d.font !== s.font) why.push(`face ${s.font} for ${d.font}`);
    if (Math.abs(d.size - s.size) > 2) why.push(`size ${s.size} for ${d.size}`);
    if (Math.abs(d.weight - s.weight) > 100) why.push(`weight ${s.weight} for ${d.weight}`);
    if (caseOf(d) !== caseOf(s)) why.push(`case ${caseOf(s)} for ${caseOf(d)}`);
    if (why.length) bad3.push(show(d) + ': ' + why.join(', '));
  }
  let [ok, said] = share(bad3, pairs.length, 0.95);
  row('D3', ok && pairs.length > 0, said + (bad3.length ? '; ' + bad3.slice(0, 10).join('; ') : ''));
  const bad4 = []; const unread = [];
  for (const [d, s] of pairs) {
    let fg; let bg;
    try { fg = dist(d.color, s.color); bg = dist(d.ground, s.ground); } catch (e) { if (e instanceof Unreadable) { unread.push(show(d) + ': ' + e.message); continue; } throw e; }
    if (fg > 12 || bg > 12) bad4.push(show(d) + `: text ${s.color} for ${d.color} (${Math.round(fg)}), on ${s.ground} for ${d.ground} (${Math.round(bg)})`);
  }
  [ok, said] = share(bad4, pairs.length, 0.95);
  if (unread.length) rows.push({ id: 'D4', verdict: 'INVALID', said: `${unread.length} colour(s) this cannot read: ` + unread.slice(0, 6).join('; ') });
  else row('D4', ok && pairs.length > 0, said + (bad4.length ? '; ' + bad4.slice(0, 8).join('; ') : ''));
  const region = (e) => (e.inFooter ? 'footer' : e.inHeader ? 'header' : 'main');
  const tops = { header: [(reference.header || {}).y || 0, (site.header || {}).y || 0], footer: [(reference.footer || {}).y || 0, (site.footer || {}).y || 0] };
  const last = {}; const bad5 = [];
  for (const [d, s] of pairs) {
    const r = region(d);
    if (['h1', 'h2', 'h3'].includes(d.tag)) last[r] = [d.y, s.y];
    const base = last[r] || tops[r] || last.main || [0, 0];
    const dy = d.y - base[0]; const sy = s.y - base[1];
    const why = [];
    if (Math.abs(d.x - s.x) > 16) why.push(`x ${s.x} for ${d.x}`);
    if (Math.abs(d.w - s.w) > Math.max(24, 0.15 * d.w)) why.push(`width ${s.w} for ${d.w}`);
    if (Math.abs(dy - sy) > 24) why.push(`${sy}px below its heading for ${dy}`);
    if (why.length) bad5.push(show(d) + ': ' + why.join(', '));
  }
  [ok, said] = share(bad5, pairs.length, 0.95);
  row('D5', ok && pairs.length > 0, said + (bad5.length ? '; ' + bad5.slice(0, 8).join('; ') : ''));
  const links = (r) => (r.navLinks || []).map((a) => [norm(a.text), a.href]);
  const dn = links(reference); const sn = links(site);
  if (scope !== 'footer') row('D6', JSON.stringify(dn) === JSON.stringify(sn) && dn.length > 0, `reference ${dn.length} links, site ${sn.length}` + (JSON.stringify(dn) === JSON.stringify(sn) ? '' : `; reference ${JSON.stringify(dn)}; site ${JSON.stringify(sn)}`));
  const dh = reference.header; const sh = site.header; const df = reference.footer; const sf = site.footer;
  const why = []; const unread7 = [];
  if (scope !== 'footer') {
    if (!sh) why.push('no header');
    else if (dh) {
      if (Math.abs(dh.h - sh.h) > 4) why.push(`header ${sh.h}px tall for ${dh.h}`);
      if ((dh.position === 'sticky') !== ['sticky', 'fixed'].includes(sh.position)) why.push(`header ${sh.position} for ${dh.position}`);
    }
  }
  if (scope !== 'header') {
    if (!sf) why.push('no footer');
    else if (df) {
      try {
        if (dist(df.bg, sf.bg) > 12) why.push(`footer on ${sf.bg} for ${df.bg}`);
        const dw = df.borderTop.split(' '); const sw = sf.borderTop.split(' ');
        if (dw[0] !== sw[0] || (dw[0] !== '0px' && dist(dw.slice(1).join(' '), sw.slice(1).join(' ')) > 12)) why.push(`footer top border ${sf.borderTop} for ${df.borderTop}`);
      } catch (e) { if (e instanceof Unreadable) unread7.push(e.message); else throw e; }
    }
  }
  if (unread7.length) rows.push({ id: 'D7', verdict: 'INVALID', said: 'a footer colour this cannot read: ' + unread7.join('; ') });
  else row('D7', !why.length, why.length ? why.join('; ') : 'header and footer as the reference');
  return rows;
}

// ---------------------------------------------------------------------------
// The two commands.
// ---------------------------------------------------------------------------

async function capture(opt) {
  const source = opt.source;
  const routes = String(opt.routes || '/').split(',').map((r) => r.trim()).filter(Boolean);
  const out = path.resolve(process.cwd(), String(opt.out || 'droost/parity'));
  const width = Number(opt.width || 1280);
  if (!source || source === true) finish({ status: 'error', summary: 'capture needs --source <url>' }, EXIT.invalid);
  const { chromium } = playwright();
  fs.mkdirSync(out, { recursive: true });
  const browser = await chromium.launch({ args: ['--disable-blink-features=AutomationControlled'] });
  const captured = [];
  for (const route of routes) {
    const reading = await read(browser, source.replace(/\/$/, '') + route, width);
    reading.route = route;
    fs.writeFileSync(path.join(out, slug(route)), JSON.stringify(reading, null, 1));
    captured.push({ route, status: reading.status, texts: (reading.texts || []).length });
  }
  await browser.close();
  fs.writeFileSync(path.join(out, 'manifest.json'), JSON.stringify({ source, width, routes, captured_at: new Date().toISOString() }, null, 1));
  const bad = captured.filter((c) => c.status !== 200 || !c.texts);
  finish({ status: bad.length ? 'invalid' : 'captured', summary: `${captured.length - bad.length} of ${captured.length} reference page(s) captured from ${source}`, routes: captured }, bad.length ? EXIT.invalid : EXIT.pass);
}

async function judgeCommand(opt) {
  const dir = path.resolve(process.cwd(), String(opt.reference || 'droost/parity'));
  const scope = ['page', 'frame', 'header', 'footer'].includes(String(opt.scope)) ? String(opt.scope) : 'page';
  let manifest = {};
  try { manifest = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8')); } catch (e) { manifest = {}; }
  const routes = opt.routes && opt.routes !== true ? String(opt.routes).split(',').map((r) => r.trim()).filter(Boolean) : (manifest.routes || []);
  const present = routes.filter((r) => fs.existsSync(path.join(dir, slug(r))));
  if (!present.length) finish({ status: 'nothing', summary: `no reference to compare with in ${path.relative(process.cwd(), dir) || dir} (capture one with: droost-parity capture --source <url> --routes /,…)` }, EXIT.nothing);
  const base = (opt.base && opt.base !== true ? String(opt.base) : '') || process.env.DROOST_PARITY_BASE_URL || process.env.PLAYWRIGHT_BASE_URL || process.env.DDEV_PRIMARY_URL || '';
  if (!base) finish({ status: 'invalid', summary: 'no site to read: pass --base, or set DROOST_PARITY_BASE_URL' }, EXIT.invalid);
  // A reference read off the site it judges agrees with it whatever the site
  // looks like: a green that could not have failed.
  const origin = (u) => { try { return new URL(u).host.toLowerCase(); } catch (e) { return String(u).toLowerCase(); } };
  if (manifest.source && origin(manifest.source) === origin(base)) {
    finish({ status: 'invalid', summary: `the reference was captured from ${manifest.source}, the site it would judge: capture it from the source the site rebuilds` }, EXIT.invalid);
  }
  const against = manifest.source ? ` against ${manifest.source}` + (manifest.captured_at ? ` (captured ${manifest.captured_at})` : '') : '';
  const { chromium } = playwright();
  const browser = await chromium.launch({ args: ['--disable-blink-features=AutomationControlled'] });
  const results = [];
  for (const route of present) {
    const reference = JSON.parse(fs.readFileSync(path.join(dir, slug(route)), 'utf8'));
    const site = await read(browser, base.replace(/\/$/, '') + route, reference.viewport || manifest.width || 1280);
    const rows = judge(reference, site, scope);
    const failed = rows.filter((r) => r.verdict === 'FAIL');
    const invalid = rows.filter((r) => r.verdict === 'INVALID');
    results.push({ route, verdict: failed.length ? 'FAIL' : invalid.length ? 'INVALID' : 'PASS', rows });
    if (!opt.json) process.stdout.write(`${route}: ${failed.length ? 'FAIL ' + failed.map((r) => r.id).join(' ') : invalid.length ? 'INVALID ' + invalid.map((r) => r.id).join(' ') : 'as the reference'}\n`);
  }
  await browser.close();
  const failedRoutes = results.filter((r) => r.verdict === 'FAIL');
  const invalidRoutes = results.filter((r) => r.verdict === 'INVALID');
  const skipped = routes.filter((r) => !present.includes(r));
  const detail = results.map((r) => ({ route: r.route, verdict: r.verdict, failing: r.rows.filter((x) => x.verdict !== 'PASS').map((x) => ({ id: x.id, verdict: x.verdict, said: String(x.said).slice(0, 400) })) }));
  if (failedRoutes.length) {
    finish({ status: 'fail', scope, source: manifest.source || null, summary: `${failedRoutes.length} of ${results.length} route(s) differ from the reference${against}: ` + failedRoutes.map((r) => `${r.route} ${r.rows.filter((x) => x.verdict === 'FAIL').map((x) => x.id).join('+')}`).join(', '), routes: detail, skipped }, EXIT.fail);
  }
  if (invalidRoutes.length) {
    finish({ status: 'invalid', scope, summary: `${invalidRoutes.length} of ${results.length} route(s) could not be judged: ` + invalidRoutes.map((r) => r.route).join(', '), routes: detail, skipped }, EXIT.invalid);
  }
  finish({ status: 'pass', scope, source: manifest.source || null, summary: `${results.length} route(s) as the reference${against} (D1–D7, ${scope} scope)` + (skipped.length ? `; no reference for ${skipped.join(', ')}` : ''), routes: detail, skipped }, EXIT.pass);
}

const opt = args(process.argv.slice(2));
const command = opt._[0] || 'judge';
(command === 'capture' ? capture(opt) : command === 'judge' ? judgeCommand(opt) : Promise.resolve(finish({ status: 'error', summary: `unknown command ${command}: capture or judge` }, EXIT.invalid)))
  .catch((e) => finish({ status: 'invalid', summary: 'the runner failed: ' + String(e && e.message || e).slice(0, 300) }, EXIT.invalid));
