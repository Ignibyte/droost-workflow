#!/usr/bin/env node
/**
 * @file
 * The parity gate's runner: does each page of the site look like its
 * reference?
 *
 * A reference is a page of the source (a design, or the site being rebuilt)
 * read once and kept in the project: every visible element that carries
 * text, with its box and the computed style that decides how it looks
 * (typeface, size, weight, case, colour, the colour it sits on), and the
 * header, footer and header links. The gate reads the same page on the site
 * and judges each element of the reference against it, matched by text in
 * document order:
 *
 *   D1  the page answers 200 and does not scroll sideways
 *   D2  every reference text is on the site, in order
 *   D3  each pair: the same typeface, size within 2px, weight within 100, the
 *       same case as rendered; every heading, and 95% of the rest
 *   D4  each pair: text colour and the colour it sits on within 12 (CIE76)
 *   D5  each pair: x within 16px, width within 15% (or 24px), and y within
 *       24px of where it sits below its section's heading
 *   D6  the header's links: the same labels and targets, in order; a target
 *       is where the link goes, not how it is spelled (F-258): a page of the
 *       source's own `/internet.html` is the site's `/internet`
 *   D7  the header's height and stickiness, the footer's colour and border
 *
 * D2 and D6 pass at 100%, D3 to D5 at 95% of pairs. The site may carry more
 * than the reference; what the reference has, the site must have, looking the
 * same. A page this cannot read, or a colour it cannot parse, is INVALID,
 * never a pass.
 *
 *   droost-parity capture --source <url> --routes /,/camps [--out droost/parity] [--width 1280[,390]]
 *   droost-parity judge [--reference droost/parity] [--routes …] [--scope page|frame|header|footer]
 *                       [--pages /,…] [--base <url>] [--json]
 *
 * A reference may hold several widths (`--width 1280,390`): the first is the
 * primary, kept as `<route>.json`, and each other as `<route>@<width>.json`.
 * Every route is judged at every width it was captured at, each at `--scope`,
 * except the routes `--pages` names, which are judged whole (page scope) at
 * the primary width: a ticket that rebuilds one page holds that page to the
 * source, and the frame everywhere, at once. A narrow width is how a
 * collapsed menu is judged: what shows in the header there must be what the
 * source shows.
 *
 * A reference text the client decided the site will not show (a link hidden
 * until an editor sets it, a language switch for a site in one language) is
 * named in `decided.json` beside the readings, with the decision that set it
 * aside (F-260):
 *
 *   {"set_aside": [{"route": "/business", "text": "Learn More", "decided": "Q6",
 *                   "why": "hidden until an editor sets its address"}]}
 *
 * The judge leaves each such text (and a header link with that label) out of
 * the route's reference, `"route": "*"` on every route, and says so in its
 * verdict. An entry with no route, text or decision, a decision that names no
 * question of the project's intake (`droost/intake/questions.md`, when there
 * is one), or a text the route's reference does not hold (once the route is
 * captured: the intake may name a later rung's page) is INVALID: what is
 * set aside is a recorded decision about the reference, never a way round it.
 * The file is part of the reference, so it is frozen with the run.
 *
 * The site's base URL: --base, else DROOST_PARITY_BASE_URL, PLAYWRIGHT_BASE_URL
 * or DDEV_PRIMARY_URL (the address the site's own browser suite uses).
 * Playwright is the project's own (node_modules/playwright).
 *
 * Exit: 0 every route as the reference; 1 a route differs; 2 a route could
 * not be read (INVALID); 3 no reference to compare with; 127 no Playwright.
 * The last line of stdout is always one JSON object, {"parity": {...}}.
 */
'use strict';

const fs = require('fs');
const path = require('path');

const EXIT = { pass: 0, fail: 1, invalid: 2, nothing: 3, noBrowser: 127 };

function args(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const key = a.slice(2);
      const next = argv[i + 1];
      if (next === undefined || next.startsWith('--')) out[key] = true;
      else { out[key] = next; i++; }
    } else out._.push(a);
  }
  return out;
}

function finish(summary, code) {
  process.stdout.write(JSON.stringify({ parity: summary }) + '\n');
  process.exit(code);
}

function playwright() {
  const where = path.join(process.cwd(), 'node_modules', 'playwright');
  try {
    return require(where);
  } catch (e) {
    finish({ status: 'no-browser', summary: `no Playwright at ${where}: install it (npm i -D playwright @playwright/test) and its Chromium` }, EXIT.noBrowser);
  }
  return null;
}

// A route's file name in the reference directory.
const slug = (route) => (route === '/' ? 'home' : route.replace(/^\/+|\/+$/g, '').replace(/[^A-Za-z0-9_-]+/g, '_')) + '.json';
// A route's reading at a width: the primary width keeps the plain name, so a
// reference captured at one width reads as it always has.
const viewFile = (route, width, primary) => (width === primary ? slug(route) : slug(route).replace(/\.json$/, `@${width}.json`));
// The widths a comma list names, in its order.
const widthsOf = (value) => String(value).split(',').map((w) => Number(w.trim())).filter((w) => Number.isInteger(w) && w > 0);

// ---------------------------------------------------------------------------
// Reading a page.
// ---------------------------------------------------------------------------

async function read(browser, url, width) {
  // A fresh context per page (no cache to serve from) and no extra request
  // header: on a cross-origin font request one forces a CORS preflight a font
  // host may fail, and the page falls back to another typeface.
  const ctx = await browser.newContext({ viewport: { width, height: 900 }, ignoreHTTPSErrors: true });
  // Images are asked for without AVIF, as a browser that lacks it asks. The
  // Chromium a Linux container runs crashed decoding an AVIF an image host
  // served for "auto=format", which ended the whole reading. The judge reads
  // text, never pixels, and the same image in another format looks the same.
  await ctx.route('**/*', (route) => {
    const req = route.request();
    if (req.resourceType() !== 'image') return route.continue();
    return route.continue({ headers: { ...req.headers(), accept: 'image/webp,image/apng,image/svg+xml,image/*;q=0.8,*/*;q=0.5' } });
  });
  const page = await ctx.newPage();
  // A page that crashes the browser is a page not read: INVALID for that
  // route, never the end of every other route's reading.
  let crashed = false;
  page.on('crash', () => { crashed = true; });
  let status = 'ERR';
  try {
    const res = await page.goto(url, { waitUntil: 'load', timeout: 60000 });
    status = res ? res.status() : 'ERR';
  } catch (e) {
    status = 'ERR ' + String(e.message || e).slice(0, 160);
  }
  const unread = (why) => ({ url, status: 'ERR ' + why, viewport: width, texts: [] });
  // Network idle when it comes within 8 s: a page with a widget that polls is
  // never idle.
  await page.waitForLoadState('networkidle', { timeout: 8000 }).catch(() => {});
  if (crashed) { await ctx.close().catch(() => {}); return unread('the page crashed the browser while loading'); }
  await page.evaluate(async () => {
    await document.fonts.ready;
    // Scroll instantly, whatever the page asks. A page with `scroll-behavior:
    // smooth` animates every scrollTo, and the reading below began while the
    // way back to the top was still running: a tall page's sticky header read
    // 54px down (F-264).
    for (const el of [document.documentElement, document.body]) if (el) el.style.setProperty('scroll-behavior', 'auto', 'important');
    // In-view animations run only once their section has been in the viewport.
    for (let y = 0; y < document.documentElement.scrollHeight; y += 300) { window.scrollTo(0, y); await new Promise((r) => setTimeout(r, 100)); }
    window.scrollTo(0, 0);
    // And read only once the page is at its top.
    for (let i = 0; i < 50 && window.scrollY !== 0; i++) { window.scrollTo(0, 0); await new Promise((r) => setTimeout(r, 100)); }
  }).catch(() => {});
  await page.waitForTimeout(1200).catch(() => {});
  if (crashed) { await ctx.close().catch(() => {}); return unread('the page crashed the browser as it scrolled'); }
  const data = await page.evaluate(() => {
    const px = (v) => Math.round(parseFloat(v) || 0);
    const ground = (el) => {
      for (let n = el; n && n.nodeType === 1; n = n.parentElement) {
        const c = getComputedStyle(n).backgroundColor;
        const m = c.match(/rgba?\(([^)]+)\)/);
        if (m) { const p = m[1].split(',').map(Number); if (p.length < 4 || p[3] > 0.5) return c; }
        if (getComputedStyle(n).backgroundImage !== 'none') return 'image';
      }
      return 'rgb(255, 255, 255)';
    };
    const visible = (el) => {
      const s = getComputedStyle(el);
      if (s.visibility === 'hidden' || s.display === 'none' || parseFloat(s.opacity) === 0) return false;
      // A transparent ancestor hides it too (F-152). Opacity is not inherited,
      // so text inside an opacity-0 parent reads 1 of its own: the design's
      // "View Profile" hover overlay, which no visitor sees at rest, was held
      // as text every page must carry.
      for (let p = el.parentElement; p; p = p.parentElement) {
        if (parseFloat(getComputedStyle(p).opacity) === 0) return false;
      }
      const r = el.getBoundingClientRect();
      return r.width > 0 && r.height > 0;
    };
    // An element's own text as it renders (F-146): text nodes side by side run
    // together, as the browser draws them (React writes "{city}, {state}" as
    // three, and "$" and "{price}" as two), and a child element between two
    // keeps a word boundary ("Ages 8-12" before a <span>Youth</span>).
    // CSS-generated text, as it draws (F-265): a ::before or ::after with a
    // string, or with a counter, numbered as the browser numbers it. A list
    // the source types "01" into and a site numbers by a counter draw the
    // same thing; read as text nodes alone, the site's had no number at all.
    const generated = (el, which) => {
      const c = getComputedStyle(el, which).content;
      if (!c || c === 'none' || c === 'normal') return '';
      const lit = /^"(.*)"$/.exec(c);
      if (lit) return lit[1];
      const m = /^counter\(([\w-]+)(?:,\s*([\w-]+))?\)$/.exec(c);
      if (!m) return '';
      const incs = (e) => (getComputedStyle(e).counterIncrement || '').split(/\s+/).includes(m[1]);
      let item = el;
      while (item && !incs(item)) item = item.parentElement;
      if (!item || !item.parentElement) return '';
      const n = [...item.parentElement.children].filter(incs).indexOf(item) + 1;
      return m[2] === 'decimal-leading-zero' ? String(n).padStart(2, '0') : String(n);
    };
    const ownText = (el) => {
      let s = generated(el, '::before');
      let run = false;
      for (const n of el.childNodes) {
        if (n.nodeType === 3) { s += (run || !s ? '' : ' ') + n.textContent; run = true; }
        else if (n.nodeType === 1) run = false;
      }
      const after = generated(el, '::after');
      if (after) s += (s ? ' ' : '') + after;
      return s.replace(/\s+/g, ' ').trim();
    };
    const texts = [];
    for (const el of document.body.querySelectorAll('*')) {
      if (['SCRIPT', 'STYLE', 'NOSCRIPT', 'SVG', 'PATH', 'TEMPLATE'].includes(el.tagName)) continue;
      const own = ownText(el);
      if (!own || !visible(el)) continue;
      const r = el.getBoundingClientRect(); const s = getComputedStyle(el);
      texts.push({
        tag: el.tagName.toLowerCase(), text: own,
        x: Math.round(r.left + scrollX), y: Math.round(r.top + scrollY), w: Math.round(r.width), h: Math.round(r.height),
        font: s.fontFamily.split(',')[0].replace(/["']/g, '').trim(), size: px(s.fontSize), weight: Number(s.fontWeight),
        transform: s.textTransform, color: s.color, ground: ground(el),
        link: el.closest('a') ? el.closest('a').getAttribute('href') : null,
        inHeader: !!el.closest('header, nav, [role=banner]'), inFooter: !!el.closest('footer, [role=contentinfo]'),
      });
    }
    const box = (el) => { if (!el) return null; const r = el.getBoundingClientRect(); const s = getComputedStyle(el);
      return { y: Math.round(r.top + scrollY), h: Math.round(r.height), bg: s.backgroundColor, bgImage: s.backgroundImage !== 'none', borderTop: s.borderTopWidth + ' ' + s.borderTopColor, position: s.position }; };
    // The header is the page's banner, its <header> (or role=banner), and its
    // first <nav> only when it has neither. F-262: a utility bar's <nav> above
    // the sticky <header> was taken for the header, so D7 measured the bar and
    // D6 held its four links and none of the main menu's.
    const header = document.querySelector('body header, body [role=banner]') || document.querySelector('body nav');
    const footer = [...document.querySelectorAll('footer')].pop() || null;
    // The header's links: every link the top of the frame shows, in a header,
    // a banner or a nav (as a text's inHeader reads it), and neither in the
    // footer nor in the page's main content.
    const navLinks = [...document.querySelectorAll('body a')].filter((a) => a.closest('header, nav, [role=banner]') && !a.closest('footer, [role=contentinfo], main, [role=main]')).filter(visible).map((a) => ({ text: a.textContent.replace(/\s+/g, ' ').trim(), href: a.getAttribute('href') }));
    return {
      height: document.documentElement.scrollHeight,
      hscroll: document.documentElement.scrollWidth > document.documentElement.clientWidth,
      header: box(header), footer: box(footer), navLinks, texts,
    };
  }).catch((e) => ({ error: String(e.message || e).slice(0, 200), texts: [] }));
  await ctx.close().catch(() => {});
  if (crashed) return unread('the page crashed the browser as it was read');
  return { url, status, viewport: width, ...data };
}

// ---------------------------------------------------------------------------
// Judging a pair of readings.
// ---------------------------------------------------------------------------

class Unreadable extends Error {}

function toRgb(c) {
  if (c === 'image') return null;
  if (!c) throw new Unreadable(JSON.stringify(c));
  if (c === 'transparent') return [255, 255, 255];
  const num = (x) => (x.endsWith('%') ? parseFloat(x) / 100 : parseFloat(x));
  let m = c.match(/^oklch\(([^)]+)\)/);
  if (m) {
    const p = m[1].trim().split(/[\s/]+/).filter(Boolean);
    const L = p[0].endsWith('%') ? parseFloat(p[0]) / 100 : parseFloat(p[0]);
    const C = p[1] !== 'none' ? parseFloat(p[1]) : 0;
    const H = p[2] !== 'none' ? parseFloat(p[2]) * Math.PI / 180 : 0;
    return toRgb(`oklab(${L} ${C * Math.cos(H)} ${C * Math.sin(H)} / ${p.length > 3 ? p[3] : '1'})`);
  }
  m = c.match(/^rgba?\(([^)]+)\)/);
  if (m) {
    const p = m[1].trim().split(/[,\s/]+/).filter(Boolean).map(num);
    const a = p.length > 3 ? p[3] : 1;
    return [0, 1, 2].map((i) => p[i] * a + 255 * (1 - a));
  }
  m = c.match(/^oklab\(([^)]+)\)/);
  if (m) {
    const p = m[1].trim().split(/[\s/]+/).filter(Boolean).map(num);
    const [L, A, B] = p; const a = p.length > 3 ? p[3] : 1;
    const l = (L + 0.3963377774 * A + 0.2158037573 * B) ** 3;
    const mm = (L - 0.1055613458 * A - 0.0638541728 * B) ** 3;
    const s = (L - 0.0894841775 * A - 1.2914855480 * B) ** 3;
    const lin = [4.0767416621 * l - 3.3077115913 * mm + 0.2309699292 * s, -1.2684380046 * l + 2.6097574011 * mm - 0.3413193965 * s, -0.0041960863 * l - 0.7034186147 * mm + 1.7076147010 * s];
    return lin.map((v) => 255 * (v <= 0.0031308 ? 12.92 * v : 1.055 * Math.max(v, 0) ** (1 / 2.4) - 0.055)).map((v) => Math.min(255, Math.max(0, v)) * a + 255 * (1 - a));
  }
  throw new Unreadable(c);
}

function lab(rgb) {
  const f = (v) => { v /= 255; return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; };
  const [r, g, b] = rgb.map(f);
  const x = (0.4124 * r + 0.3576 * g + 0.1805 * b) / 0.95047; const y = 0.2126 * r + 0.7152 * g + 0.0722 * b; const z = (0.0193 * r + 0.1192 * g + 0.9505 * b) / 1.08883;
  const g_ = (t) => (t > 0.008856 ? t ** (1 / 3) : 7.787 * t + 16 / 116);
  return [116 * g_(y) - 16, 500 * (g_(x) - g_(y)), 200 * (g_(y) - g_(z))];
}

function dist(c1, c2) {
  const a = toRgb(c1); const b = toRgb(c2);
  if (a === null || b === null) return (c1 === 'image') === (c2 === 'image') ? 0 : 99;
  const [p, q] = [lab(a), lab(b)];
  return Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]);
}

// Where a link goes, read against the page it was found on (F-258). A path
// on the page's own origin is the page it names: `/internet.html`,
// `/internet/` and `/internet` are one page, `/index.html` is `/`, so a
// static source's links compare with the clean paths a CMS serves. Another
// host's link keeps its host and path; `tel:` keeps its digits; `#` stays.
function linkTarget(href, pageUrl) {
  if (href === null || href === undefined) return '';
  const raw = String(href).trim();
  if (raw === '' || raw.startsWith('#')) return raw;
  if (/^tel:/i.test(raw)) return 'tel:' + raw.replace(/\D/g, '');
  if (/^mailto:/i.test(raw)) return raw.toLowerCase();
  let u;
  try {
    u = new URL(raw, pageUrl || 'http://x.invalid/');
  } catch (e) {
    return raw;
  }
  let own = false;
  try {
    own = !/^[a-z][a-z0-9+.-]*:/i.test(raw) || (pageUrl && u.origin === new URL(pageUrl).origin);
  } catch (e) {
    own = !/^[a-z][a-z0-9+.-]*:/i.test(raw);
  }
  const path = u.pathname.replace(/\/index\.html?$/i, '/').replace(/\.html?$/i, '').replace(/\/+$/, '') || '/';
  return own ? path + u.search : u.origin + (path === '/' ? '' : path) + u.search;
}

const norm = (t) => t.normalize('NFKC').replace(/–|—/g, '-').replace(/’/g, "'").replace(/\s+/g, ' ').trim().toLowerCase();
const caseOf = (e) => (e.transform === 'uppercase' || (e.text.toUpperCase() === e.text && e.text.toLowerCase() !== e.text) ? 'upper' : 'as-written');

// difflib.SequenceMatcher(None, a, b, autojunk=False).get_matching_blocks().
function matchingBlocks(a, b) {
  const b2j = new Map();
  b.forEach((x, j) => { if (!b2j.has(x)) b2j.set(x, []); b2j.get(x).push(j); });
  const longest = (alo, ahi, blo, bhi) => {
    let besti = alo; let bestj = blo; let bestsize = 0; let j2len = new Map();
    for (let i = alo; i < ahi; i++) {
      const next = new Map();
      for (const j of b2j.get(a[i]) || []) {
        if (j < blo) continue;
        if (j >= bhi) break;
        const k = (j2len.get(j - 1) || 0) + 1;
        next.set(j, k);
        if (k > bestsize) { besti = i - k + 1; bestj = j - k + 1; bestsize = k; }
      }
      j2len = next;
    }
    return [besti, bestj, bestsize];
  };
  const queue = [[0, a.length, 0, b.length]]; const blocks = [];
  while (queue.length) {
    const [alo, ahi, blo, bhi] = queue.pop();
    const [i, j, k] = longest(alo, ahi, blo, bhi);
    if (k) {
      blocks.push([i, j, k]);
      if (alo < i && blo < j) queue.push([alo, i, blo, j]);
      if (i + k < ahi && j + k < bhi) queue.push([i + k, ahi, j + k, bhi]);
    }
  }
  return blocks.sort((x, y) => x[0] - y[0] || x[1] - y[1]);
}

function judge(reference, site, scope, aside = new Set()) {
  let D = (reference.texts || []).filter((e) => !aside.has(norm(e.text))); let S = site.texts || [];
  if (aside.size) reference = { ...reference, navLinks: (reference.navLinks || []).filter((a) => !aside.has(norm(a.text || ''))) };
  if (['frame', 'header', 'footer'].includes(scope)) {
    const keep = { frame: (e) => e.inHeader || e.inFooter, header: (e) => e.inHeader, footer: (e) => e.inFooter }[scope];
    D = D.filter(keep); S = S.filter(keep);
  }
  const rows = [];
  if (!Number.isInteger(site.status) || !(site.texts || []).length) {
    rows.push({ id: 'D1', verdict: 'INVALID', said: `the page was not read (status ${String(site.status).slice(0, 120)}, ${(site.texts || []).length} texts)` });
    return rows;
  }
  const pairs = [];
  for (const [i, j, n] of matchingBlocks(D.map((e) => norm(e.text)), S.map((e) => norm(e.text)))) for (let k = 0; k < n; k++) pairs.push([D[i + k], S[j + k]]);
  const matched = new Set(pairs.map(([d]) => d));
  const missing = D.filter((d) => !matched.has(d));
  const row = (id, ok, said, extra = {}) => rows.push({ id, verdict: ok ? 'PASS' : 'FAIL', said, ...extra });
  const share = (bad, n, need) => { const got = n ? 1 - bad.length / n : 0; return [got >= need, `${n - bad.length}/${n} pairs (${Math.round(got * 100)}%, needs ${Math.round(need * 100)}%)`]; };
  const show = (e) => `${e.tag} "${e.text.slice(0, 40)}"`;

  row('D1', site.status === 200 && !site.hscroll, `HTTP ${site.status}, scrolls sideways: ${site.hscroll ? 'yes' : 'no'}`);
  row('D2', !missing.length && D.length > 0, `${pairs.length}/${D.length} reference texts found in order` + (missing.length ? '; missing: ' + missing.slice(0, 12).map(show).join('; ') : ''), { missing: missing.map((d) => d.text) });
  // Every heading, and 95% of the rest (F-148): a page has few headings and
  // they carry its type, so a share over every text let all of them differ.
  const bad3 = []; const badHeads = [];
  for (const [d, s] of pairs) {
    const why = [];
    if (d.font !== s.font) why.push(`face ${s.font} for ${d.font}`);
    if (Math.abs(d.size - s.size) > 2) why.push(`size ${s.size} for ${d.size}`);
    if (Math.abs(d.weight - s.weight) > 100) why.push(`weight ${s.weight} for ${d.weight}`);
    if (caseOf(d) !== caseOf(s)) why.push(`case ${caseOf(s)} for ${caseOf(d)}`);
    if (why.length) { bad3.push(show(d) + ': ' + why.join(', ')); if (/^h[1-6]$/.test(d.tag)) badHeads.push(show(d)); }
  }
  let [ok, said] = share(bad3, pairs.length, 0.95);
  row('D3', ok && pairs.length > 0 && !badHeads.length, said + (badHeads.length ? `; ${badHeads.length} heading(s) differ, and every heading must match` : '') + (bad3.length ? '; ' + bad3.slice(0, 10).join('; ') : ''));
  const bad4 = []; const unread = [];
  for (const [d, s] of pairs) {
    let fg; let bg;
    try { fg = dist(d.color, s.color); bg = dist(d.ground, s.ground); } catch (e) { if (e instanceof Unreadable) { unread.push(show(d) + ': ' + e.message); continue; } throw e; }
    if (fg > 12 || bg > 12) bad4.push(show(d) + `: text ${s.color} for ${d.color} (${Math.round(fg)}), on ${s.ground} for ${d.ground} (${Math.round(bg)})`);
  }
  [ok, said] = share(bad4, pairs.length, 0.95);
  if (unread.length) rows.push({ id: 'D4', verdict: 'INVALID', said: `${unread.length} colour(s) this cannot read: ` + unread.slice(0, 6).join('; ') });
  else row('D4', ok && pairs.length > 0, said + (bad4.length ? '; ' + bad4.slice(0, 8).join('; ') : ''));
  const region = (e) => (e.inFooter ? 'footer' : e.inHeader ? 'header' : 'main');
  const tops = { header: [(reference.header || {}).y || 0, (site.header || {}).y || 0], footer: [(reference.footer || {}).y || 0, (site.footer || {}).y || 0] };
  const last = {}; const bad5 = [];
  for (const [d, s] of pairs) {
    const r = region(d);
    if (['h1', 'h2', 'h3'].includes(d.tag)) last[r] = [d.y, s.y];
    const base = last[r] || tops[r] || last.main || [0, 0];
    const dy = d.y - base[0]; const sy = s.y - base[1];
    const why = [];
    if (Math.abs(d.x - s.x) > 16) why.push(`x ${s.x} for ${d.x}`);
    if (Math.abs(d.w - s.w) > Math.max(24, 0.15 * d.w)) why.push(`width ${s.w} for ${d.w}`);
    if (Math.abs(dy - sy) > 24) why.push(`${sy}px below its heading for ${dy}`);
    if (why.length) bad5.push(show(d) + ': ' + why.join(', '));
  }
  [ok, said] = share(bad5, pairs.length, 0.95);
  row('D5', ok && pairs.length > 0, said + (bad5.length ? '; ' + bad5.slice(0, 8).join('; ') : ''));
  const links = (r) => (r.navLinks || []).map((a) => [norm(a.text), linkTarget(a.href, r.url)]);
  const dn = links(reference); const sn = links(site);
  if (scope !== 'footer') row('D6', JSON.stringify(dn) === JSON.stringify(sn) && dn.length > 0, `reference ${dn.length} links, site ${sn.length}` + (JSON.stringify(dn) === JSON.stringify(sn) ? '' : `; reference ${JSON.stringify(dn)}; site ${JSON.stringify(sn)}`));
  const dh = reference.header; const sh = site.header; const df = reference.footer; const sf = site.footer;
  const why = []; const unread7 = [];
  if (scope !== 'footer') {
    if (!sh) why.push('no header');
    else if (dh) {
      if (Math.abs(dh.h - sh.h) > 4) why.push(`header ${sh.h}px tall for ${dh.h}`);
      if ((dh.position === 'sticky') !== ['sticky', 'fixed'].includes(sh.position)) why.push(`header ${sh.position} for ${dh.position}`);
    }
  }
  if (scope !== 'header') {
    if (!sf) why.push('no footer');
    else if (df) {
      try {
        if (dist(df.bg, sf.bg) > 12) why.push(`footer on ${sf.bg} for ${df.bg}`);
        const dw = df.borderTop.split(' '); const sw = sf.borderTop.split(' ');
        if (dw[0] !== sw[0] || (dw[0] !== '0px' && dist(dw.slice(1).join(' '), sw.slice(1).join(' ')) > 12)) why.push(`footer top border ${sf.borderTop} for ${df.borderTop}`);
      } catch (e) { if (e instanceof Unreadable) unread7.push(e.message); else throw e; }
    }
  }
  if (unread7.length) rows.push({ id: 'D7', verdict: 'INVALID', said: 'a footer colour this cannot read: ' + unread7.join('; ') });
  else row('D7', !why.length, why.length ? why.join('; ') : 'header and footer as the reference');
  return rows;
}

// What the client decided the site will not show (F-260): `decided.json` in
// the reference, checked against the readings and the intake's questions.
// Returns the entries, or the reason they cannot be used.
function readDecided(dir, views, questionsFile) {
  const file = path.join(dir, 'decided.json');
  if (!fs.existsSync(file)) return { entries: [] };
  let doc;
  try { doc = JSON.parse(fs.readFileSync(file, 'utf8')); } catch (e) { return { error: `decided.json is not JSON: ${String(e.message).slice(0, 120)}` }; }
  const entries = Array.isArray(doc && doc.set_aside) ? doc.set_aside : null;
  if (!entries) return { error: 'decided.json holds no "set_aside" list' };
  let ids = null;
  if (questionsFile && fs.existsSync(questionsFile)) {
    ids = new Set();
    for (const line of fs.readFileSync(questionsFile, 'utf8').split('\n')) {
      const m = /^\|\s*([A-Za-z]+-?\d+)\s*\|/.exec(line);
      if (m) ids.add(m[1]);
    }
  }
  const held = (route, text) => views.some((v) => (route === '*' || v.route === route) && v.texts.concat(v.links).some((t) => norm(t) === norm(text)));
  for (const [i, e] of entries.entries()) {
    const at = `decided.json's entry ${i + 1}`;
    if (!e || typeof e.route !== 'string' || typeof e.text !== 'string' || typeof e.decided !== 'string' || !e.route || !e.text.trim() || !e.decided.trim()) return { error: `${at} needs a route, a text and the decision that set it aside` };
    if (ids && !ids.has(e.decided.trim())) return { error: `${at} ("${e.text.slice(0, 40)}") cites ${e.decided}, which is no question of the intake (${path.relative(process.cwd(), questionsFile)})` };
    // A route with no reading yet (a later rung's page) is checked once it
    // is captured; "*" must be held on some route now.
    const read = e.route === '*' || views.some((v) => v.route === e.route);
    if (read && !held(e.route, e.text)) return { error: `${at} sets aside "${e.text.slice(0, 40)}" on ${e.route}, which the reference does not hold there` };
  }
  return { entries };
}

const asideFor = (entries, route) => new Set(entries.filter((e) => e.route === '*' || e.route === route).map((e) => norm(e.text)));

const asideSaid = (entries) => (entries.length ? '; set aside by decision: ' + entries.map((e) => `"${e.text.slice(0, 40)}" on ${e.route} (${e.decided})`).join(', ') : '');

// ---------------------------------------------------------------------------
// The two commands.
// ---------------------------------------------------------------------------

async function capture(opt) {
  const source = opt.source;
  const routes = String(opt.routes || '/').split(',').map((r) => r.trim()).filter(Boolean);
  const out = path.resolve(process.cwd(), String(opt.out || 'droost/parity'));
  const widths = widthsOf(opt.width && opt.width !== true ? opt.width : 1280);
  if (!widths.length) finish({ status: 'error', summary: 'capture needs --width <px>[,<px>…]' }, EXIT.invalid);
  const width = widths[0];
  if (!source || source === true) finish({ status: 'error', summary: 'capture needs --source <url>' }, EXIT.invalid);
  const { chromium } = playwright();
  fs.mkdirSync(out, { recursive: true });
  const browser = await chromium.launch({ args: ['--disable-blink-features=AutomationControlled'] });
  const captured = [];
  for (const route of routes) {
    for (const w of widths) {
      const reading = await read(browser, source.replace(/\/$/, '') + route, w);
      reading.route = route;
      fs.writeFileSync(path.join(out, viewFile(route, w, width)), JSON.stringify(reading, null, 1));
      captured.push({ route, width: w, status: reading.status, texts: (reading.texts || []).length });
    }
  }
  await browser.close();
  const manifest = { source, width, routes, captured_at: new Date().toISOString() };
  if (widths.length > 1) manifest.widths = widths;
  fs.writeFileSync(path.join(out, 'manifest.json'), JSON.stringify(manifest, null, 1));
  const bad = captured.filter((c) => c.status !== 200 || !c.texts);
  finish({ status: bad.length ? 'invalid' : 'captured', summary: `${captured.length - bad.length} of ${captured.length} reference page(s) captured from ${source}`, routes: captured }, bad.length ? EXIT.invalid : EXIT.pass);
}

async function judgeCommand(opt) {
  const dir = path.resolve(process.cwd(), String(opt.reference || 'droost/parity'));
  const scope = ['page', 'frame', 'header', 'footer'].includes(String(opt.scope)) ? String(opt.scope) : 'page';
  let manifest = {};
  try { manifest = JSON.parse(fs.readFileSync(path.join(dir, 'manifest.json'), 'utf8')); } catch (e) { manifest = {}; }
  const routes = opt.routes && opt.routes !== true ? String(opt.routes).split(',').map((r) => r.trim()).filter(Boolean) : (manifest.routes || []);
  const widths = Array.isArray(manifest.widths) && widthsOf(manifest.widths.join(',')).length ? widthsOf(manifest.widths.join(',')) : [Number(manifest.width || 1280)];
  const primary = widths[0];
  const pages = opt.pages && opt.pages !== true ? String(opt.pages).split(',').map((r) => r.trim()).filter(Boolean) : [];
  // Every route at every width it was captured at; a page named whole at the
  // primary width.
  const views = [];
  const skipped = [];
  for (const route of routes) {
    for (const width of widths) {
      const file = viewFile(route, width, primary);
      const name = width === primary ? route : `${route}@${width}`;
      if (fs.existsSync(path.join(dir, file))) views.push({ route, width, file, name, scope: width === primary && pages.includes(route) ? 'page' : scope });
      else skipped.push(name);
    }
  }
  // A page named whole with nothing to hold it to is a lever the reference
  // cannot keep, never a page skipped.
  const unheld = pages.filter((p) => !views.some((v) => v.route === p && v.width === primary));
  if (unheld.length) finish({ status: 'invalid', summary: `${unheld.join(', ')} ${unheld.length === 1 ? 'is' : 'are'} to be judged whole and the reference holds no reading of ${unheld.length === 1 ? 'it' : 'them'} at ${primary}px: capture ${unheld.length === 1 ? 'it' : 'them'} from the source` }, EXIT.invalid);
  const present = views.map((v) => v.route);
  if (!present.length) finish({ status: 'nothing', summary: `no reference to compare with in ${path.relative(process.cwd(), dir) || dir} (capture one with: droost-parity capture --source <url> --routes /,…)` }, EXIT.nothing);
  const base = (opt.base && opt.base !== true ? String(opt.base) : '') || process.env.DROOST_PARITY_BASE_URL || process.env.PLAYWRIGHT_BASE_URL || process.env.DDEV_PRIMARY_URL || '';
  if (!base) finish({ status: 'invalid', summary: 'no site to read: pass --base, or set DROOST_PARITY_BASE_URL' }, EXIT.invalid);
  // A reference read off the site it judges agrees with it whatever the site
  // looks like: a green that could not have failed.
  const origin = (u) => { try { return new URL(u).host.toLowerCase(); } catch (e) { return String(u).toLowerCase(); } };
  if (manifest.source && origin(manifest.source) === origin(base)) {
    finish({ status: 'invalid', summary: `the reference was captured from ${manifest.source}, the site it would judge: capture it from the source the site rebuilds` }, EXIT.invalid);
  }
  const readings = views.map((v) => {
    const r = JSON.parse(fs.readFileSync(path.join(dir, v.file), 'utf8'));
    return { route: v.route, texts: (r.texts || []).map((t) => t.text), links: (r.navLinks || []).map((a) => a.text || '') };
  });
  const decided = readDecided(dir, readings, path.resolve(process.cwd(), 'droost/intake/questions.md'));
  if (decided.error) finish({ status: 'invalid', summary: decided.error }, EXIT.invalid);
  const aside = decided.entries;
  const against = manifest.source ? ` against ${manifest.source}` + (manifest.captured_at ? ` (captured ${manifest.captured_at})` : '') : '';
  const { chromium } = playwright();
  const browser = await chromium.launch({ args: ['--disable-blink-features=AutomationControlled'] });
  const results = [];
  for (const view of views) {
    const reference = JSON.parse(fs.readFileSync(path.join(dir, view.file), 'utf8'));
    const site = await read(browser, base.replace(/\/$/, '') + view.route, reference.viewport || view.width);
    const rows = judge(reference, site, view.scope, asideFor(aside, view.route));
    const failed = rows.filter((r) => r.verdict === 'FAIL');
    const invalid = rows.filter((r) => r.verdict === 'INVALID');
    results.push({ ...view, verdict: failed.length ? 'FAIL' : invalid.length ? 'INVALID' : 'PASS', rows });
    if (!opt.json) process.stdout.write(`${view.name} (${view.scope}): ${failed.length ? 'FAIL ' + failed.map((r) => r.id).join(' ') : invalid.length ? 'INVALID ' + invalid.map((r) => r.id).join(' ') : 'as the reference'}\n`);
  }
  await browser.close();
  const failedRoutes = results.filter((r) => r.verdict === 'FAIL');
  const invalidRoutes = results.filter((r) => r.verdict === 'INVALID');
  const detail = results.map((r) => ({ route: r.route, view: r.name, width: r.width, scope: r.scope, verdict: r.verdict, failing: r.rows.filter((x) => x.verdict !== 'PASS').map((x) => ({ id: x.id, verdict: x.verdict, said: String(x.said).slice(0, 400) })) }));
  // One width and one scope reads as it always has; more says what was held.
  const counted = widths.length > 1 ? `${results.length} view(s) (${routes.length} route(s) at ${widths.join(' and ')}px)` : `${results.length} route(s)`;
  const held = `${scope} scope` + (pages.length ? `; page scope for ${pages.join(', ')} at ${primary}px` : '');
  if (failedRoutes.length) {
    finish({ status: 'fail', scope, source: manifest.source || null, summary: `${failedRoutes.length} of ${counted} differ from the reference${against}: ` + failedRoutes.map((r) => `${r.name} ${r.rows.filter((x) => x.verdict === 'FAIL').map((x) => x.id).join('+')}`).join(', ') + asideSaid(aside), routes: detail, skipped, set_aside: aside }, EXIT.fail);
  }
  if (invalidRoutes.length) {
    finish({ status: 'invalid', scope, summary: `${invalidRoutes.length} of ${counted} could not be judged: ` + invalidRoutes.map((r) => r.name).join(', ') + asideSaid(aside), routes: detail, skipped, set_aside: aside }, EXIT.invalid);
  }
  finish({ status: 'pass', scope, source: manifest.source || null, summary: `${counted} as the reference${against} (D1–D7, ${held})` + (skipped.length ? `; no reference for ${skipped.join(', ')}` : '') + asideSaid(aside), routes: detail, skipped, set_aside: aside }, EXIT.pass);
}

if (require.main === module) {
  const opt = args(process.argv.slice(2));
  const command = opt._[0] || 'judge';
  (command === 'capture' ? capture(opt) : command === 'judge' ? judgeCommand(opt) : Promise.resolve(finish({ status: 'error', summary: `unknown command ${command}: capture or judge` }, EXIT.invalid)))
    .catch((e) => finish({ status: 'invalid', summary: 'the runner failed: ' + String(e && e.message || e).slice(0, 300) }, EXIT.invalid));
}

module.exports = { linkTarget, judge, readDecided, asideFor, read };
