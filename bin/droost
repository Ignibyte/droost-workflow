#!/usr/bin/env php
<?php

/**
 * @file
 * droost: this codebase's knowledge, read from files, and the workflow's run.
 *
 * `droost` lists the commands, `droost <command> help` explains one. No
 * Drupal is booted and drush is never called. See
 * \Droost\Workflow\Knowledge\DroostCli.
 */

declare(strict_types=1);

use Droost\Workflow\Cli\ArgvDispatcher;

// `droost guard <verb>` is the guard, the same script bin/droost-guard runs
// (the entry a harness's hooks call, which loads no autoloader). It reads its
// verb from $argv and exits itself.
if (($argv[1] ?? '') === 'guard') {
  $argv = [__DIR__ . '/../pack/hooks/droost-workflow-guard.php', ...array_slice($argv, 2)];
  $argc = count($argv);
  require __DIR__ . '/../pack/hooks/droost-workflow-guard.php';
  exit(0);
}
use Droost\Workflow\Knowledge\DroostCli;

// The installing project's autoloader first (Composer's bin proxy names it),
// then a copied install's, then a checkout's own: the same order, for the
// same reason, as bin/droost-workflow (F-155).
$autoloaders = array_values(array_filter([
  isset($GLOBALS['_composer_autoload_path']) && is_string($GLOBALS['_composer_autoload_path']) ? $GLOBALS['_composer_autoload_path'] : NULL,
  __DIR__ . '/../../../autoload.php',
  __DIR__ . '/../vendor/autoload.php',
]));
$loaded = FALSE;
foreach ($autoloaders as $autoloader) {
  if (is_file($autoloader)) {
    require_once $autoloader;
    $loaded = TRUE;
    break;
  }
}
if (!$loaded) {
  fwrite(STDERR, "droost: could not find vendor/autoload.php — run composer install.\n");
  exit(2);
}

$cwd = getcwd();
if ($cwd === FALSE) {
  fwrite(STDERR, "droost: could not determine the working directory.\n");
  exit(2);
}

$out = static function (string $line): void {
  fwrite(STDOUT, $line . "\n");
};
$err = static function (string $line): void {
  fwrite(STDERR, $line . "\n");
};

$workflow = static function (array $argv) use ($cwd, $out, $err): int {
  $dispatcher = new ArgvDispatcher(
    $out,
    $err,
    static fn (): string => date('c'),
    static fn (): string => 'run-' . bin2hex(random_bytes(6)),
  );
  return $dispatcher->dispatch(array_values(array_map('strval', $argv)), $cwd);
};

$cli = new DroostCli($cwd, $workflow, dirname(__DIR__), $out, $err, getenv('CLAUDE_PROJECT_DIR'));
exit($cli->run(array_values(array_slice($argv, 1))));
