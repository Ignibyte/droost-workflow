#!/usr/bin/env php
<?php

/**
 * @file
 * The retired name of `droost workflow:<verb>`.
 *
 * Runs the same verbs as `droost workflow:<verb>`, and says on stderr which
 * one it stands for, so a caller parsing stdout reads the same as before.
 */

declare(strict_types=1);

use Droost\Workflow\Cli\ArgvDispatcher;

// Works both from this package's own vendor/ and from a consuming project's,
// so the bin behaves the same whether it was installed as a dependency or is
// being developed in place.
//
// THE PROJECT'S FIRST (F-155). Through a symlinked path repository __DIR__
// is this checkout's real bin/, so `../vendor/autoload.php` was the
// checkout's own development vendor, and a project running the bin loaded
// that instead of its own. Composer's bin proxy names the autoloader of the
// project that installed the bin; a copied install finds it three levels up;
// only a checkout run in place falls back to its own.
$autoloaders = array_values(array_filter([
  isset($GLOBALS['_composer_autoload_path']) && is_string($GLOBALS['_composer_autoload_path']) ? $GLOBALS['_composer_autoload_path'] : NULL,
  __DIR__ . '/../../../autoload.php',
  __DIR__ . '/../vendor/autoload.php',
]));
$loaded = FALSE;
foreach ($autoloaders as $autoloader) {
  if (is_file($autoloader)) {
    require_once $autoloader;
    $loaded = TRUE;
    break;
  }
}
if (!$loaded) {
  fwrite(STDERR, "Could not find vendor/autoload.php — run composer install.\n");
  exit(2);
}

$root = getcwd();
if ($root === FALSE) {
  fwrite(STDERR, "Could not determine the working directory.\n");
  exit(2);
}

$dispatcher = new ArgvDispatcher(
  static function (string $line): void {
    fwrite(STDOUT, $line . "\n");
  },
  static function (string $line): void {
    fwrite(STDERR, $line . "\n");
  },
  static fn (): string => date('c'),
  static fn (): string => 'run-' . bin2hex(random_bytes(6)),
);

// `droost workflow:<verb>` is the name now; this one keeps working. The
// note goes to stderr, so a caller parsing stdout reads the same as before.
$verb = $argv[1] ?? '';
if ($verb !== '' && !str_starts_with($verb, '-') && $verb !== 'help') {
  fwrite(STDERR, sprintf("droost-workflow is now `droost workflow:%s`.\n", $verb));
}

exit($dispatcher->dispatch(array_slice($argv, 1), $root));
