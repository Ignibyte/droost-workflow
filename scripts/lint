#!/usr/bin/env bash
#
# The droost_workflow gate: phpcs, phpstan (level max), phpunit.
#
# All three legs are HARD. droost's equivalent script skips phpstan and
# phpunit when their binaries are absent, because that repo has no vendor/ of
# its own and those gates are CI-authoritative. This package requires nothing
# but PHP, so a missing binary means the environment is wrong, not that the
# gate is inapplicable — it fails, and it says which invocation it could not
# run.
#
# Usage:
#   scripts/lint              # every leg over the whole package
#   scripts/lint src/Config   # scope phpcs to a subset (a fast pre-commit)

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

TARGETS=("$@")
FAIL=0

require_bin() {
  local bin="$1"
  if [ ! -x "$bin" ]; then
    printf '  \033[31mFAIL\033[0m  %s is missing — run: composer install\n' "$bin"
    return 1
  fi
  return 0
}

run_leg() {
  local label="$1"
  shift
  if "$@"; then
    printf '  \033[32mPASS\033[0m  %s\n' "$label"
  else
    printf '  \033[31mFAIL\033[0m  %s (%s)\n' "$label" "$*"
    FAIL=1
  fi
}

echo "droost_workflow gate"

if require_bin vendor/bin/phpcs; then
  if [ ${#TARGETS[@]} -gt 0 ]; then
    run_leg "phpcs (Drupal,DrupalPractice)" \
      vendor/bin/phpcs --standard=./phpcs.xml.dist -s "${TARGETS[@]}"
  else
    run_leg "phpcs (Drupal,DrupalPractice)" \
      vendor/bin/phpcs --standard=./phpcs.xml.dist -s
  fi
else
  FAIL=1
fi

if require_bin vendor/bin/phpstan; then
  run_leg "phpstan (level max)" \
    vendor/bin/phpstan analyse -c ./phpstan.neon --no-progress --memory-limit=1G
else
  FAIL=1
fi

# TICKET-136: say what this gate does NOT cover. `modules/droost_workflow_mcp`
# needs droost + mcp_server + the mcp/sdk to be type-checked, and only a real
# site has all three, so its phpstan runs there (see phpstan.neon for why no
# portable scanDirectories list can work). A green run must never read as
# coverage it does not have.
if [ -d modules/droost_workflow_mcp ]; then
  printf '  NOTE  modules/droost_workflow_mcp is NOT analysed locally (needs droost + mcp_server + mcp/sdk).\n'
  printf '        Run it where those exist:\n'
  printf '        ddev exec "cd /var/www/contrib/droost/droost_workflow && php vendor/bin/phpstan \\\n'
  printf '          analyse -c phpstan-mcp-site.neon --autoload-file /var/www/html/vendor/autoload.php"\n'
fi

if require_bin vendor/bin/phpunit; then
  run_leg "phpunit" vendor/bin/phpunit --no-progress
else
  FAIL=1
fi

if [ "$FAIL" -eq 0 ]; then
  printf '\033[32mGATE GREEN\033[0m — 3 legs run, 0 skipped\n'
else
  printf '\033[31mGATE RED\033[0m — fix at the source (no baselines, §0)\n'
fi

exit "$FAIL"
